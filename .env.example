# ============================================================================
# Zombie Coder — Sunucu (Cloud Run / Node.js Backend) Ortam Değişkenleri Örneği
# ============================================================================
# Bu dosyayı `.env` olarak kopyalayın ve kendi değerlerinizi girin:
#   cp .env.example .env
#
# GÜVENLİK NOTU:
# - `.env` dosyası `.gitignore` içindedir ve kesinlikle Git deposuna eklenmez.
# - `GEMINI_API_KEY` yalnızca arka uç (backend/) servisi tarafından okunur;
#   mobil istemci paketine (React Native bundle) asla gömülmez.
# ============================================================================

# Google AI Studio / Gemini API Anahtarı (Personalzy Günlük Analiz Ajanı için)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Kullanılacak Gemini Modeli (agent.md ile uyumlu varsayılan model)
# Interactions API önek istemez: "models/" ile yazılırsa backend öneki kendisi temizler.
GEMINI_MODEL=gemini-3.8-flash

# NPC sohbetleri için model (düşük gecikme gerekir; gemini-3.8-flash 30-100 sn sürebiliyor)
GEMINI_NPC_MODEL=gemini-3.5-flash

# Birincil NPC modeli NPC_HEDGE_AFTER_MS içinde dönmezse paralel çağrılan hızlı model (boş = kapalı)
GEMINI_NPC_BACKUP_MODEL=gemini-3.1-flash-lite
NPC_HEDGE_AFTER_MS=6000

# Bir NPC mesajı için Gemini'ye ayrılan toplam süre (ms)
NPC_CHAT_TIMEOUT_MS=20000

# Backend HTTP Sunucu Portu (Cloud Run varsayılanı: 8080)
PORT=8080

# Oyuncu Başına Günlük Token Bütçesi Üst Sınırı
DAILY_TOKEN_BUDGET_PER_PLAYER=50000

# Oyuncu Başına Dakikalık Maksimum İstek Sayısı (Rate Limit)
MAX_RPM_PER_PLAYER=10
